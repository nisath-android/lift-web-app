# Browser application: only these two values may be exposed in client-side code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Reserved for a future trusted server-to-server integration. Never commit or
# put a service-role key in dist/. The current lift-api function deliberately
# uses the caller's JWT plus database role checks and does not need this key.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins permitted by the Edge Function's CORS policy.
LIFT_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://lift-route-match-poc-2026.surebread129.chatgpt.site
